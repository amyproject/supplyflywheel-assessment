# Optional: HMAC secret for signed media URLs + resume links (auto-generated and stored in the DB if unset)
SESSION_SECRET=
# SQLite file (system of record for the local/single-node deployment)
DATABASE_PATH=./data/assessment.db
# Private recording storage (never served statically)
STORAGE_DIR=./storage
# Speech-to-text provider adapter: openai | none
TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional transactional email for invitations and sign-in links (Resend)
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3230
# Admin login. On every start the app ensures this super admin exists with this password (12+ chars).
# Set these on your host (Railway/Render/etc.) — they are NOT in git.
ADMIN_EMAIL=admin@supplyflywheel.dev
ADMIN_PASSWORD=
